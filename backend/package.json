{
  "name": "learnai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for learnAI - turns PDF documents into summaries, flashcards, quizzes and contextual chat with Google Gemini.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/*.test.js\""
  },
  "keywords": [
    "education",
    "ai",
    "gemini",
    "express",
    "mongodb",
    "study-assistant"
  ],
  "author": "MD Iftakhar Hossain Rafi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iftakharH/learnAI.git"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5"
  }
}
