# Environment variables for the learnAI backend.
# Copy to the repository root as `.env` (the server also reads `backend/.env`).
# Never commit the real file.

# --- Required ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learnai?retryWrites=true&w=majority
MONGODB_DB_NAME=learnai

# Use a long random string (32+ characters recommended).
JWT_SECRET=replace_me_with_a_long_random_string

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_me

# --- Optional ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Model IDs are retired regularly. The service falls back to gemini-flash-latest
# if the configured model disappears.
GEMINI_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=45000
AI_MAX_TEXT_CHARS=400000
AI_MAX_RETRIES=1

# Comma-separated allowlist, or `*` to allow every origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

JWT_EXPIRES_IN=30d
UPLOAD_MAX_BYTES=15728640
MONGODB_CONNECT_RETRIES=5
MONGODB_TIMEOUT_MS=10000

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_DISABLED=true
