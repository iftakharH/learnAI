{
  "name": "learnai",
  "version": "1.0.0",
  "private": true,
  "description": "AI study assistant - monorepo root. The API lives in backend/, the app in frontend/.",
  "engines": {
    "node": ">=22.3.0 <23"
  },
  "scripts": {
    "postinstall": "npm --prefix backend ci --omit=dev --no-audit --no-fund",
    "start": "node backend/server.js",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  }
}
